# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# Catalog read replica (read-only). The app only runs SELECTs and sets its session to READ ONLY.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Local model served by Ollama - use the exact name shown by `ollama list`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Safety cap on fitment applications fetched per search
MAX_APPS=500
